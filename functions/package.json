{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "scrape": "ts-node -r tsconfig-paths/register --project tsconfig.json scripts/scrape-local.ts",
    "scrape:store": "ts-node -r tsconfig-paths/register --project tsconfig.json scripts/scrape-local.ts --store"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@sparticuz/chromium": "^130.0.0",
    "cheerio": "^1.2.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "groq-sdk": "^1.3.0",
    "puppeteer-core": "^21.11.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
